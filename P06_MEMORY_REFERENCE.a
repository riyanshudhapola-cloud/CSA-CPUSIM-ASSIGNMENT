; Practical 6 : ADD, LDA, STA, BUN, ISZ
; Multiply X by N using repeated addition. X = 5, N = 3 -> PROD = 15
LOOP:   LDA PROD
        ADD X
        STA PROD
        ISZ CTR         ; CTR <- CTR + 1; skip next if zero
        BUN LOOP
        LDA PROD
        HLT
X:      .data 1 5
CTR:    .data 1 -3
PROD:   .data 1 0
